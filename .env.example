# Copy to .env and fill in real values locally. Never commit .env.
# Placeholders only. No real secrets in this file.

# App
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL (app role must NOT own tables; migrations use a separate owner role)
POSTGRES_DB=rakshak
DATABASE_URL=postgresql+asyncpg://<app_role>:<app_password>@localhost:5432/rakshak
MIGRATION_DATABASE_URL=postgresql+asyncpg://<owner_role>:<owner_password>@localhost:5432/rakshak

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET_KEY=<generate-a-long-random-secret>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=<minutes>

# Gemini (accessed only through LLMProvider)
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_CHAT_MODEL=<gemini-chat-model-name>
GEMINI_EMBEDDING_MODEL=<gemini-embedding-model-name>

# Object storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage

# Upload limits
MAX_UPLOAD_MB=<max-upload-size-mb>
MAX_PDF_PAGES=<max-pages-per-pdf>

# Sharing
DOCTOR_SESSION_MINUTES=30
SHARE_PIN_MAX_ATTEMPTS=5

# Observability (Langfuse with masking)
LANGFUSE_PUBLIC_KEY=<langfuse-public-key>
LANGFUSE_SECRET_KEY=<langfuse-secret-key>
LANGFUSE_HOST=<langfuse-host-url>
