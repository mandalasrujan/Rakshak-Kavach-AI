# Copy to .env and replace every placeholder locally. Never commit .env.
# Placeholders only. No real secrets in this file.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"

# App
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL (Docker Compose builds DATABASE_URL from these; use a URL-safe password)
POSTGRES_DB=rakshak
POSTGRES_USER=rakshak
POSTGRES_PASSWORD=change-me-postgres-password

# Used only when running the API/migrations outside Docker Compose.
# The app role must NOT own tables once M6 adds RLS; until M6 both URLs may use the same role.
DATABASE_URL=postgresql+asyncpg://rakshak:change-me-postgres-password@localhost:5432/rakshak
MIGRATION_DATABASE_URL=postgresql+asyncpg://rakshak:change-me-postgres-password@localhost:5432/rakshak

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth (the API refuses to start with a placeholder or short secret)
JWT_SECRET_KEY=change-me-generate-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# DEVELOPMENT ONLY: set to false only for plain-http local testing in browsers that
# reject Secure cookies on http://localhost. The API refuses COOKIE_SECURE=false
# when APP_ENV=production.
COOKIE_SECURE=true

# Login and registration rate limits (fixed window, stored in Redis)
LOGIN_MAX_ATTEMPTS_PER_EMAIL=5
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_WINDOW_SECONDS=900
REGISTER_MAX_ATTEMPTS_PER_IP=10
REGISTER_WINDOW_SECONDS=3600

# Gemini (accessed only through LLMProvider; not used before M6)
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_CHAT_MODEL=<gemini-chat-model-name>
GEMINI_EMBEDDING_MODEL=<gemini-embedding-model-name>

# Object storage (used from M4)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage

# Upload limits (used from M4)
MAX_UPLOAD_MB=<max-upload-size-mb>
MAX_PDF_PAGES=<max-pages-per-pdf>

# Sharing (used from M14)
DOCTOR_SESSION_MINUTES=30
SHARE_PIN_MAX_ATTEMPTS=5

# Observability (Langfuse with masking; not used before tracing is added)
LANGFUSE_PUBLIC_KEY=<langfuse-public-key>
LANGFUSE_SECRET_KEY=<langfuse-secret-key>
LANGFUSE_HOST=<langfuse-host-url>
